# ---------------------------------------------------------------------------
# Every value here is optional. With no .env at all the project runs on its
# offline, deterministic stack: no API key, no model download, no network.
# ---------------------------------------------------------------------------

# Required only when RECON_USE_REAL_LLM=true.
ANTHROPIC_API_KEY=

# Backend selection. false -> the deterministic offline stand-in.
RECON_USE_REAL_LLM=false
RECON_USE_REAL_EMBEDDINGS=true

# Model overrides.
RECON_LLM_MODEL=claude-haiku-4-5-20251001
RECON_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Path overrides — handy for pointing a run at a different batch.
# RECON_DATA_RAW_DIR=data/raw
# RECON_DATA_PROCESSED_DIR=data/processed
# RECON_DATA_OUTPUTS_DIR=data/outputs

# Test-only: run the suite against the real stack instead of the offline one.
# RECON_TEST_USE_REAL_STACK=false
